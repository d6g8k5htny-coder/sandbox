+    if not isinstance(ref, str) or not ref.strip():
+        raise AdapterError(f"{label} ref missing or empty")
+    cleaned = ref.strip()
+    if set(cleaned) <= {"0"}:
+        raise AdapterError(f"{label} ref is unavailable/all-zero: {cleaned!r}")
+    return cleaned
