+    """Load a repository-relative JSON blob at an immutable git ref."""
+    ref = _reject_all_zero_sha(ref, label="git")
+    rel = relative.replace("\\", "/")
+    cp = subprocess.run(
+        ["git", "-C", str(root), "show", f"{ref}:{rel}"],
+        capture_output=True,
+        text=True,
+        timeout=60,
+    )
+    if cp.returncode != 0:
+        raise AdapterError(
+            f"unavailable object {rel!r} at {ref}: {cp.stderr.strip()[:200]}"
+        )
+    try:
+        return json.loads(cp.stdout)
+    except json.JSONDecodeError as exc:
+        raise AdapterError(f"malformed JSON {rel!r} at {ref}: {exc}") from exc
