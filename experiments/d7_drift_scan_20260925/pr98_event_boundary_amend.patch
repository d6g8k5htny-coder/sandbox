+def _require_id_list(record: dict[str, Any], field: str) -> list[str]:
+    """Fail closed on present-but-invalid depends_on / sub_obligations containers.
+
+    Missing key ⇒ empty list (genuine omission). Present False/0/""/{}/null/str
+    must not be swallowed by `x or []`.
+    """
+    if field not in record:
+        return []
+    value = record[field]
+    if not isinstance(value, list):
+        raise AdapterError(
+            f"{field} must be a list of id strings when present, "
+            f"got {type(value).__name__}: {value!r}"
+        )
+    out: list[str] = []
+    for item in value:
+        if type(item) is not str or not item:
+            raise AdapterError(
+                f"{field} entries must be nonempty strings, got {item!r}"
+            )
+        out.append(item)
+    return out
