+
+# Fields that may change under a pure binding-precision / coverage migration (E6).
+# Any other claims-record field change is independent semantic impact and must
+# still refuse retained controlling use.
+_BINDING_ONLY_RECORD_FIELDS = frozenset(
+    {
+        "source_bindings",
+        "source",
+        "mirror_path",
+        "canon_source",
+    }
+)
+
+
+def _nonbinding_identity_changed(
+    old_node: dict[str, Any], new_node: dict[str, Any]
+) -> bool:
+    """True when non-binding node identity diverges (E6).
+
+    Coverage-repair exemptions may only apply when binding/source fields move
+    while statement/deps/grade/classification/version (etc.) stay fixed.
+    """
+    for key in (
+        "classification",
+        "version",
+        "source_grade",
+        "source_status",
+        "source_controlling",
+        "bucket",
+    ):
+        if old_node.get(key) != new_node.get(key):
+            return True
+    old_statuses = old_node.get("source_statuses") or []
+    new_statuses = new_node.get("source_statuses") or []
+    if old_statuses != new_statuses:
+        return True
+    old_snap = old_node.get("source_snapshot")
+    new_snap = new_node.get("source_snapshot")
+    if isinstance(old_snap, str) and isinstance(new_snap, str):
+        try:
+            old_r = json.loads(old_snap)
+            new_r = json.loads(new_snap)
+        except json.JSONDecodeError:
+            return old_snap != new_snap
+        if not isinstance(old_r, dict) or not isinstance(new_r, dict):
+            return old_snap != new_snap
+
+        def strip(record: dict[str, Any]) -> dict[str, Any]:
+            return {
+                key: value
+                for key, value in record.items()
+                if key not in _BINDING_ONLY_RECORD_FIELDS
+            }
+
+        return json.dumps(
+            strip(old_r), sort_keys=True, separators=(",", ":"), ensure_ascii=False
+        ) != json.dumps(
+            strip(new_r), sort_keys=True, separators=(",", ":"), ensure_ascii=False
+        )
+    return False
+
